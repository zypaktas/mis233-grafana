      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "zeynepsudem-campus-datasource",
            "uid": "campus-sensors"
          },
          "building": "$building",
          "metric": "$metric",
          "aggregation": "avg",
          "interval": "auto",
          "format": "table"
        }
